    {
      "name": "01 Salud PostgreSQL 18",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test(\"PostgreSQL 18\", () => pm.expect(result.data.version).to.match(/^18\\./));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 GET productos sin campos _id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "function check(value) { if (Array.isArray(value)) value.forEach(check); else if (value && typeof value === \"object\") Object.entries(value).forEach(([k,v]) => { pm.expect(k.endsWith(\"_id\")).to.equal(false); check(v); }); }",
              "pm.test(\"Sanitizacion recursiva\", () => check(result));"
            ]
          }
        }
      ]
    },
