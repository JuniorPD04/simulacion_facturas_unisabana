# PostgreSQL 18 local. Copia este archivo como .env y configura tu usuario.
DB_NAME=papel_y_luna
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_ADMIN_NAME=postgres
HOST=127.0.0.1
PORT=8000
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Opcional en desarrollo; obligatorio y privado para un despliegue real.
DJANGO_SECRET_KEY=
# Autenticacion: vigencia del token de sesion y usuarios de ejemplo (seed).
# Cambia las contraseñas antes de un despliegue real.
SESSION_TTL_HOURS=12
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin123
SEED_CAJERO_USER=cajero
SEED_CAJERO_PASSWORD=cajero123
